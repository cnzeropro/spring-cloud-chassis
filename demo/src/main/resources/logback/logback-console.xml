<?xml version="1.0" encoding="UTF-8"?>
<!-- 控制台日志配置 -->
<included>
    <!-- 控制台日志输出方式 -->
    <property name="CONSOLE_LOG_TARGET" value="${CONSOLE_LOG_TARGET:-System.out}"/>
    <!-- 控制台日志级别 -->
    <property name="CONSOLE_LOG_LEVEL" value="${CONSOLE_LOG_LEVEL:-INFO}"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <target>${CONSOLE_LOG_TARGET:-System.out}</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_LEVEL}</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>
</included>