            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- openfeign（服务调用） -->
        <!--
            Feign 和 OpenFeign：
            feign原本是Netflix提供的一个轻量级RESTful的HTTP服务客户端，内置了ribbon，用来做客户端负载均衡，去调用服务注册中心的服务
            于是基于feign提供了spring-cloud-starter-feign组件，成为spring官方推荐
            后来，在2019年Netflix不再维护feign，feign转由社区维护，并更名为openfeign
            于是又基于openfeign进行包装，并在Spring Cloud Netflix Feign的基础上支持了SpringMVC的注解
            因此spring-cloud-starter-openfeign代替spring-cloud-starter-feign组件，成为官方维护、推荐组件
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- feign（服务调用） -->
        <!-- 在Spring Cloud Finchley及以上版本已过期，被spring-cloud-starter-openfeign组件替代 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-feign</artifactId>
            <version>1.4.7.RELEASE</version>
        </dependency>
        <!-- resilience4j（服务熔断） -->
        <!-- Spring Cloud 2020.0版本以后，Resilience4J正式替换Hystrix，但目前Resilience4J还比较小众 -->
        <!-- 非响应式 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- 响应式 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>
        <!-- loadbalancer（负载均衡） -->
        <!-- Spring Cloud 2020.0版本以后，官方默认推荐使用Spring Cloud Loadbalancer正式替换Ribbon，并成为了Spring Cloud负载均衡器的唯一实现 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- gateway（网关） -->
        <!--
            Zuul 1.x（第一代Zuul）官宣会进行优化性能问题，结果Netflix跳票
            spring官方不得不推出新一代网关Gateway，此时Spring Cloud Gateway就已经替换了Zuul
            后来Netflix发布Zuul 2.x，又开始抢占了一部分市场
            再后来Zuul进入维护阶段，到Spring Cloud 2020.0版本以后，Zuul已从Spring Cloud中删除
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
